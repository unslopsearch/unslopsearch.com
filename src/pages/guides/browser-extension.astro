---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />

		<!-- Favicon -->
		<link rel="icon" type="image/svg+xml" href="/icon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/icon-32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/icon-16.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

		<!-- Primary Meta Tags -->
		<title>Unslop Search Browser Extension - Auto-Disable AI Overview</title>
		<meta name="title" content="Unslop Search Browser Extension - Auto-Disable AI Overview" />
		<meta name="description" content="Install the Unslop Search Chrome extension to automatically disable AI Overview on Google, DuckDuckGo, and Brave. Free, private, no data collection." />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://unslopsearch.com/guides/browser-extension" />
		<meta property="og:title" content="Unslop Search Browser Extension - Auto-Disable AI Overview" />
		<meta property="og:description" content="Install the Unslop Search Chrome extension to automatically disable AI Overview on Google, DuckDuckGo, and Brave. Free, private, no data collection." />
		<link rel="canonical" href="https://unslopsearch.com/guides/browser-extension/" />
	</head>
	<body>
		<div class="container">
			<nav class="breadcrumb">
				<a href="/">Home</a>
				<span>/</span>
				<a href="/guides">Guides</a>
				<span>/</span>
				<span>Browser Extension</span>
			</nav>

			<div class="hero">
				<div class="coming-soon-badge">Coming Soon</div>
				<div class="hero-icon">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
						<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
					</svg>
				</div>
				<h1>Unslop Search Extension</h1>
				<p class="hero-subtitle">Automatically filter AI from every search</p>

				<div class="cta-buttons">
					<span class="cta-button primary disabled">
						<svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
							<circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2"/>
							<circle cx="12" cy="12" r="4"/>
						</svg>
						Pending Chrome Web Store Review
					</span>
					<span class="cta-note">Free &bull; No account required &bull; Available soon</span>
				</div>
			</div>

			<section id="features">
				<h2>Features</h2>
				<div class="features-grid">
					<div class="feature">
						<div class="feature-icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<circle cx="11" cy="11" r="8"></circle>
								<path d="M21 21l-4.35-4.35"></path>
							</svg>
						</div>
						<h3>Multi-Engine Support</h3>
						<p>Works on Google, DuckDuckGo, and Brave Search. More engines coming soon.</p>
					</div>

					<div class="feature">
						<div class="feature-icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
							</svg>
						</div>
						<h3>Privacy First</h3>
						<p>No data collection. No tracking. No analytics. Everything stays on your device.</p>
					</div>

					<div class="feature">
						<div class="feature-icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<circle cx="12" cy="12" r="3"></circle>
								<path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
							</svg>
						</div>
						<h3>Configurable</h3>
						<p>Choose your preferred search engine and AI-disabling method (udm=14 or -ai).</p>
					</div>

					<div class="feature">
						<div class="feature-icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
							</svg>
						</div>
						<h3>Instant</h3>
						<p>Works automatically on every search. No extra clicks or steps required.</p>
					</div>

					<div class="feature">
						<div class="feature-icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
								<path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
							</svg>
						</div>
						<h3>Open Source</h3>
						<p>View the code yourself. No hidden functionality or surprises.</p>
					</div>

					<div class="feature">
						<div class="feature-icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
							</svg>
						</div>
						<h3>Lightweight</h3>
						<p>Tiny footprint. No impact on browser performance or page load times.</p>
					</div>
				</div>
			</section>

			<section id="how-it-works">
				<h2>How It Works</h2>
				<div class="steps">
					<div class="step">
						<span class="step-number">1</span>
						<div class="step-content">
							<h3>Install the Extension</h3>
							<p>Add Unslop Search to Chrome from the Chrome Web Store (or load it manually).</p>
						</div>
					</div>
					<div class="step">
						<span class="step-number">2</span>
						<div class="step-content">
							<h3>Search Normally</h3>
							<p>Use Google, DuckDuckGo, or Brave Search as you normally would.</p>
						</div>
					</div>
					<div class="step">
						<span class="step-number">3</span>
						<div class="step-content">
							<h3>AI is Automatically Removed</h3>
							<p>The extension adds the appropriate parameters to disable AI Overview before the page loads.</p>
						</div>
					</div>
				</div>
			</section>

			<section id="install">
				<h2>Installation</h2>

				<div class="install-option">
					<h3>Chrome Web Store (Recommended)</h3>
					<p>The easiest way to install. Updates automatically.</p>
					<a href="#" class="cta-button secondary">
						<svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18">
							<circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2"/>
							<circle cx="12" cy="12" r="4"/>
						</svg>
						Chrome Web Store
					</a>
					<p class="install-note">Coming soon - pending review</p>
				</div>

				<div class="install-option">
					<h3>Manual Installation</h3>
					<p>Install directly from source. Great for developers or if you want to verify the code.</p>
					<ol>
						<li>Download the extension files</li>
						<li>Go to <code>chrome://extensions</code> in Chrome</li>
						<li>Enable "Developer mode" in the top right</li>
						<li>Click "Load unpacked" and select the extension folder</li>
					</ol>
				</div>

				<div class="install-option">
					<h3>Other Browsers</h3>
					<ul>
						<li><strong>Edge</strong> - Install from Chrome Web Store (Edge supports Chrome extensions)</li>
						<li><strong>Brave</strong> - Install from Chrome Web Store</li>
						<li><strong>Firefox</strong> - Coming soon</li>
						<li><strong>Safari</strong> - Not currently supported</li>
					</ul>
				</div>
			</section>

			<section id="permissions">
				<h2>Permissions Explained</h2>
				<p>The extension requires minimal permissions to function:</p>

				<div class="permissions-list">
					<div class="permission">
						<h3>Storage</h3>
						<p>Saves your preferences (preferred search engine, mode) locally on your device. Never sent anywhere.</p>
					</div>
					<div class="permission">
						<h3>Web Navigation</h3>
						<p>Detects when you navigate to a search engine so we can apply AI-filtering parameters.</p>
					</div>
					<div class="permission">
						<h3>Host Permissions</h3>
						<p>Access to Google, DuckDuckGo, and Brave Search domains only - to modify search URLs.</p>
					</div>
				</div>

				<p>We follow a strict <a href="/privacy">privacy policy</a>. No data ever leaves your device.</p>
			</section>

			<section id="firefox">
				<h2>Disable AI in Firefox</h2>
				<p>Firefox users can also enjoy AI-free search results. Here's how to disable Google AI in Firefox.</p>

				<div class="install-option">
					<h3>Option 1: Unslop Search Firefox Add-on</h3>
					<p>Our Firefox extension is coming soon. It will automatically disable AI on Google, DuckDuckGo, and Brave Search.</p>
					<p class="install-note">Firefox Add-ons - Coming soon</p>
				</div>

				<div class="install-option">
					<h3>Option 2: Set Unslop Search as Default (Recommended)</h3>
					<p>Even without an extension, you can use AI-free search in Firefox:</p>
					<ol>
						<li>Visit <a href="/">unslopsearch.com</a></li>
						<li>Click in the address bar - look for the green + icon with a magnifying glass</li>
						<li>Click to add "Unslop Search" to Firefox</li>
						<li>Go to <strong>Settings</strong> &rarr; <strong>Search</strong></li>
						<li>Set Unslop Search as your default search engine</li>
					</ol>
					<p>Now all your searches from the address bar will be AI-free automatically.</p>
				</div>

				<div class="install-option">
					<h3>Option 3: Manual URL Method</h3>
					<p>Create a bookmark or custom search engine with this URL for AI-free Google searches:</p>
					<code>https://www.google.com/search?q=%s&udm=14</code>
					<p>To add as a custom search engine in Firefox:</p>
					<ol>
						<li>Type <code>about:config</code> in the address bar</li>
						<li>Search for <code>browser.urlbar.update2.engineAliasRefresh</code></li>
						<li>Set to <code>true</code></li>
						<li>Go to Settings &rarr; Search &rarr; Search Shortcuts &rarr; Add</li>
					</ol>
				</div>

				<div class="install-option">
					<h3>Why Firefox Users Need This</h3>
					<p>Google's AI Overview appears in Firefox just like in Chrome. While Firefox has better privacy defaults than Chrome, it doesn't block AI-generated summaries from appearing in Google search results.</p>
					<p>Using Unslop Search or the <code>udm=14</code> parameter ensures you get classic "10 blue links" results regardless of which browser you use.</p>
				</div>
			</section>

			<section id="alternatives">
				<h2>Alternatives</h2>
				<p>Don't want to install an extension? Other options:</p>
				<ul>
					<li><strong><a href="/">Unslop Search website</a></strong> - Use as your default search engine</li>
					<li><strong><a href="/guides/disable-ai-overview-google">Manual methods</a></strong> - Add udm=14 yourself</li>
					<li><strong>Other extensions:</strong> Bye Bye Google AI, Hide Google AI Overviews, uBlock Origin filters</li>
				</ul>
			</section>

			<section id="faq">
				<h2>FAQ</h2>

				<div class="faq-item">
					<h3>Does this extension track my searches?</h3>
					<p>No. The extension operates entirely on your device. No data is collected, stored, or transmitted. We have no servers to send data to.</p>
				</div>

				<div class="faq-item">
					<h3>Will this break anything?</h3>
					<p>No. The extension only modifies search URLs by adding parameters like <code>udm=14</code>. It doesn't inject scripts or modify page content.</p>
				</div>

				<div class="faq-item">
					<h3>Can I still use AI if I want to?</h3>
					<p>Yes. You can disable the extension temporarily, or manually remove the <code>udm=14</code> parameter from any search URL to see AI results.</p>
				</div>

				<div class="faq-item">
					<h3>Is the source code available?</h3>
					<p>Yes. The extension is open source. Contact us if you'd like to review the code.</p>
				</div>
			</section>

			<div class="final-cta">
				<h2>Ready to search without AI?</h2>
				<p class="final-note">The extension is currently pending Chrome Web Store review.</p>
				<a href="/" class="cta-button primary large">Use Unslop Search Now</a>
				<p>No extension needed - works in any browser</p>
			</div>
		</div>
	</body>
</html>

<style is:global>
	* {
		box-sizing: border-box;
	}

	body {
		font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
		background: #1a1a2e;
		min-height: 100vh;
		margin: 0;
		padding: 40px 20px;
		color: #ccc;
		line-height: 1.7;
	}

	.container {
		max-width: 750px;
		margin: 0 auto;
	}

	.breadcrumb {
		font-size: 0.85rem;
		margin-bottom: 2rem;
	}

	.breadcrumb a {
		color: #4285f4;
		text-decoration: none;
	}

	.breadcrumb a:hover {
		text-decoration: underline;
	}

	.breadcrumb span {
		color: #555;
		margin: 0 0.5rem;
	}

	/* Hero */
	.hero {
		text-align: center;
		padding: 2rem 0 3rem;
		position: relative;
	}

	.coming-soon-badge {
		display: inline-block;
		background: linear-gradient(135deg, #f59e0b, #d97706);
		color: #fff;
		font-size: 0.75rem;
		font-weight: 600;
		padding: 6px 16px;
		border-radius: 20px;
		text-transform: uppercase;
		letter-spacing: 1px;
		margin-bottom: 1.5rem;
	}

	.hero-icon {
		width: 80px;
		height: 80px;
		background: rgba(66, 133, 244, 0.1);
		border-radius: 20px;
		display: flex;
		align-items: center;
		justify-content: center;
		margin: 0 auto 1.5rem;
	}

	.hero-icon svg {
		width: 40px;
		height: 40px;
		color: #4285f4;
	}

	h1 {
		color: #fff;
		font-size: 2.25rem;
		margin: 0 0 0.5rem 0;
		font-weight: 400;
	}

	.hero-subtitle {
		color: #888;
		font-size: 1.15rem;
		margin: 0 0 2rem 0;
	}

	.cta-buttons {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
	}

	.cta-button {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		background: #4285f4;
		color: #fff;
		padding: 14px 28px;
		border-radius: 10px;
		font-weight: 500;
		font-size: 1rem;
		text-decoration: none;
		transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
	}

	.cta-button:hover {
		background: #3367d6;
		transform: translateY(-2px);
		box-shadow: 0 4px 12px rgba(66, 133, 244, 0.3);
		text-decoration: none;
	}

	.cta-button.disabled {
		background: #555;
		cursor: default;
		opacity: 0.8;
	}

	.cta-button.disabled:hover {
		background: #555;
		transform: none;
		box-shadow: none;
	}

	.cta-button.secondary {
		background: transparent;
		border: 1px solid rgba(66, 133, 244, 0.5);
		color: #4285f4;
	}

	.cta-button.secondary:hover {
		background: rgba(66, 133, 244, 0.1);
		border-color: #4285f4;
	}

	.cta-button.large {
		padding: 16px 32px;
		font-size: 1.1rem;
	}

	.cta-note {
		color: #666;
		font-size: 0.85rem;
	}

	/* Sections */
	section {
		margin-bottom: 3.5rem;
	}

	h2 {
		color: #fff;
		font-size: 1.5rem;
		margin-bottom: 1.25rem;
		font-weight: 500;
	}

	h3 {
		color: #ddd;
		font-size: 1.05rem;
		margin: 0 0 0.5rem 0;
		font-weight: 500;
	}

	p {
		margin: 0 0 1rem 0;
		color: #aaa;
	}

	ul, ol {
		margin: 0 0 1rem 0;
		padding-left: 1.5rem;
		color: #aaa;
	}

	li {
		margin-bottom: 0.5rem;
	}

	strong {
		color: #ddd;
	}

	a {
		color: #4285f4;
		text-decoration: none;
	}

	a:hover {
		text-decoration: underline;
	}

	code {
		background: rgba(255, 255, 255, 0.1);
		padding: 2px 6px;
		border-radius: 4px;
		color: #e0e0e0;
		font-size: 0.9em;
	}

	/* Features Grid */
	.features-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 1.25rem;
	}

	.feature {
		background: #252542;
		border-radius: 12px;
		padding: 1.5rem;
	}

	.feature-icon {
		width: 44px;
		height: 44px;
		background: rgba(66, 133, 244, 0.1);
		border-radius: 10px;
		display: flex;
		align-items: center;
		justify-content: center;
		margin-bottom: 1rem;
	}

	.feature-icon svg {
		width: 22px;
		height: 22px;
		color: #4285f4;
	}

	.feature h3 {
		font-size: 1rem;
	}

	.feature p {
		font-size: 0.9rem;
		margin: 0;
		color: #888;
	}

	/* Steps */
	.steps {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.step {
		display: flex;
		gap: 1.25rem;
		align-items: flex-start;
	}

	.step-number {
		width: 40px;
		height: 40px;
		background: #4285f4;
		color: #fff;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		font-weight: 600;
		flex-shrink: 0;
	}

	.step-content h3 {
		margin-top: 0.25rem;
	}

	.step-content p {
		margin: 0;
	}

	/* Install Options */
	.install-option {
		background: #252542;
		border-radius: 12px;
		padding: 1.5rem;
		margin-bottom: 1rem;
	}

	.install-option h3 {
		margin-top: 0;
	}

	.install-option ol {
		margin-bottom: 0;
	}

	.install-note {
		font-size: 0.85rem;
		color: #666;
		margin: 0.5rem 0 0 0;
		font-style: italic;
	}

	/* Permissions */
	.permissions-list {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin: 1rem 0;
	}

	.permission {
		background: #252542;
		border-radius: 8px;
		padding: 1.25rem;
	}

	.permission h3 {
		color: #4285f4;
	}

	.permission p {
		margin: 0;
		font-size: 0.9rem;
	}

	/* FAQ */
	.faq-item {
		margin-bottom: 1.5rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.05);
	}

	.faq-item:last-child {
		border-bottom: none;
		margin-bottom: 0;
		padding-bottom: 0;
	}

	.faq-item h3 {
		color: #fff;
	}

	.faq-item p:last-child {
		margin-bottom: 0;
	}

	/* Final CTA */
	.final-cta {
		text-align: center;
		background: rgba(66, 133, 244, 0.08);
		border-radius: 16px;
		padding: 3rem 2rem;
		border: 1px solid rgba(66, 133, 244, 0.15);
	}

	.final-cta h2 {
		margin-top: 0;
	}

	.final-cta .final-note {
		color: #f59e0b;
		margin-bottom: 1.5rem;
	}

	.final-cta p {
		margin-top: 1rem;
		margin-bottom: 0;
		color: #666;
	}
</style>
