								<td>Decentralized</td>
							</tr>
						</tbody>
					</table>
				</div>
			</section>

			<section id="duckduckgo">
				<h2>DuckDuckGo</h2>
				<div class="engine-card">
					<div class="engine-header">
						<div class="engine-info">
							<span class="engine-tag">Most Popular</span>
							<span class="engine-tag">Bangs Feature</span>
						</div>
					</div>
					<p>The most well-known private search engine. Uses Bing's index combined with their own crawler, but doesn't track you.</p>

					<h3>Privacy Features</h3>
					<ul>
						<li>No search history stored</li>
						<li>No IP address logging</li>
						<li>No user profiles created</li>
						<li>Email protection service</li>
						<li>App tracking protection (mobile)</li>
					</ul>

					<div class="pros-cons">
						<div class="pros">
							<h4>Pros</h4>
							<ul>
								<li>Great search quality</li>
								<li>!Bang shortcuts</li>
								<li>Browser and mobile apps</li>
								<li>Established reputation</li>
							</ul>
						</div>
						<div class="cons">
							<h4>Cons</h4>
							<ul>
								<li>Uses Bing's index</li>
								<li>Based in USA (Five Eyes)</li>
								<li>Some AI features added</li>
							</ul>
						</div>
					</div>

					<a href="/guides/duckduckgo-vs-google" class="learn-more">Compare DuckDuckGo vs Google &rarr;</a>
				</div>
			</section>

			<section id="startpage">
				<h2>Startpage</h2>
				<div class="engine-card">
					<div class="engine-header">
						<div class="engine-info">
							<span class="engine-tag green">Google Results</span>
							<span class="engine-tag green">No AI</span>
						</div>
					</div>
					<p>Acts as a privacy proxy for Google. You get Google-quality results without Google tracking you.</p>

					<h3>Privacy Features</h3>
					<ul>
						<li>Anonymous View - browse sites privately</li>
						<li>No cookies by default</li>
						<li>No IP logging</li>
						<li>EU-based (GDPR compliant)</li>
					</ul>

					<div class="pros-cons">
						<div class="pros">
							<h4>Pros</h4>
							<ul>
								<li>Google-quality results</li>
								<li>Anonymous View feature</li>
								<li>No AI features</li>
								<li>Based in Netherlands</li>
							</ul>
						</div>
						<div class="cons">
							<h4>Cons</h4>
							<ul>
								<li>Can be slower</li>
								<li>Sometimes rate-limited</li>
								<li>Dependent on Google</li>
							</ul>
						</div>
					</div>

					<a href="/guides/startpage-search-engine" class="learn-more">Learn more about Startpage &rarr;</a>
				</div>
			</section>

			<section id="brave">
				<h2>Brave Search</h2>
				<div class="engine-card">
					<div class="engine-header">
						<div class="engine-info">
							<span class="engine-tag">Own Index</span>
							<span class="engine-tag">Fast</span>
						</div>
					</div>
					<p>Built by the Brave browser team with their own independent search index - not relying on Google or Bing.</p>

					<h3>Privacy Features</h3>
					<ul>
						<li>Independent index (no Google/Bing)</li>
						<li>No tracking or profiling</li>
						<li>Anonymous usage metrics only</li>
						<li>Optional Goggles for custom ranking</li>
					</ul>

					<div class="pros-cons">
						<div class="pros">
							<h4>Pros</h4>
							<ul>
								<li>Truly independent</li>
								<li>Very fast</li>
								<li>Good result quality</li>
								<li>AI is opt-in only</li>
							</ul>
						</div>
						<div class="cons">
							<h4>Cons</h4>
							<ul>
								<li>Smaller index than Google</li>
								<li>Based in USA</li>
								<li>Linked to Brave browser</li>
							</ul>
